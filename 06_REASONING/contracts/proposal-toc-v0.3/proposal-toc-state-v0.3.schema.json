{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aer.local/schemas/proposal-toc-state-v0.3.schema.json",
  "title": "AER Proposal TOC State v0.3",
  "type": "object",
  "required": ["contract_version", "case_id", "fixture_scope", "source_registry", "source_relationships", "source_authority_matrix", "human_inputs", "rfp_constraints", "content_policies", "source_conflicts", "toc_nodes", "requirements", "mappings", "baseline_snapshot", "approval_state", "rpa_release"],
  "properties": {
    "contract_version": {"const": "0.3.0"},
    "case_id": {"type": "string", "minLength": 1},
    "fixture_scope": {"enum": ["full_state", "representative_slice"]},
    "evidence_metrics": {"type": "object"},
    "source_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "source_relationships": {"type": "array", "items": {"$ref": "#/$defs/sourceRelationship"}},
    "source_authority_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceAuthority"}},
    "human_inputs": {"type": "object", "required": ["proposal_mode", "proposal_mode_basis", "participant_count", "related_performance_provided"]},
    "rfp_constraints": {"type": "object", "required": ["page_budgets", "allowed_page_formats", "a3_count_multiplier", "consortium_policy", "official_toc_node_ids"]},
    "content_policies": {"type": "array", "items": {"$ref": "#/$defs/contentPolicy"}},
    "source_conflicts": {"type": "array", "items": {"type": "object"}},
    "toc_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tocNode"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}},
    "baseline_snapshot": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "approval_state": {"type": "object", "required": ["llm_check", "human_check", "allocation_status", "blocking_conflicts"]},
    "rpa_release": {"type": "object", "required": ["state", "explicit_release_required", "released_by", "released_at", "page_specs"]}
  },
  "$defs": {
    "source": {"type": "object", "required": ["source_id", "source_type", "name", "authority", "status"]},
    "sourceRelationship": {"type": "object", "required": ["from_source_id", "to_source_id", "relation"]},
    "sourceAuthority": {"type": "object", "required": ["domain", "source_id", "priority"]},
    "pageBudget": {
      "type": "object",
      "required": ["page_budget_id", "volume_id", "mode", "target_pages", "counted_scope_node_ids", "excluded_node_ids", "status"],
      "properties": {
        "page_budget_id": {"type": "string", "minLength": 1},
        "volume_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["RFP_EXACT", "RFP_UNLIMITED", "RFP_UNSPECIFIED"]},
        "target_pages": {"type": ["integer", "null"], "minimum": 1},
        "counted_scope_node_ids": {"type": "array", "items": {"type": "string"}},
        "excluded_node_ids": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "RFP_EXACT"}}}, "then": {"properties": {"target_pages": {"type": "integer"}}}},
        {"if": {"properties": {"mode": {"enum": ["RFP_UNLIMITED", "RFP_UNSPECIFIED"]}}}, "then": {"properties": {"target_pages": {"type": "null"}}}}
      ]
    },
    "contentPolicy": {"type": "object", "required": ["policy_id", "scope_volume_id", "type", "rule"]},
    "tocNode": {"type": "object", "required": ["node_id", "volume_id", "page_budget_id", "parent_id", "level", "title", "origin", "official_fixed", "leaf", "requirement_ids", "a3_checked", "physical_sheets", "counted_pages", "owner_no_llm", "pm_note", "human_check"]},
    "requirement": {"type": "object", "required": ["requirement_id", "obligation_id", "name", "summary", "destination", "source_id", "evidence"]},
    "mapping": {"type": "object", "required": ["map_id", "obligation_id", "target_node_id", "relation", "evidence", "validation_status"]}
  },
  "allOf": [
    {"properties": {"rfp_constraints": {"properties": {"page_budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageBudget"}}}}}}
  ]
}
